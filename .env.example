# Your Oakstack API key (https://oakstack.dev/dashboard/api-keys). Use an ok_test_ key
# while trying this out: everything is checked and logged, nothing is really sent.
OAKSTACK_API_KEY=

# This app's public https URL (Oakstack calls it for cron jobs and webhooks).
# Locally: `cloudflared tunnel --url http://localhost:3000` and paste the https URL.
APP_URL=

# Written by `npm run setup`:
OAKSTACK_CRON_SECRET=
OAKSTACK_WEBHOOK_SECRET=
OAKSTACK_PUSH_APP_ID=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Who gets the shop's emails and pushes (you), and a "from" address on a domain you've
# verified in Oakstack (Email page). Test keys accept any address.
SHOP_OWNER_EMAIL=
SHOP_FROM_EMAIL=
